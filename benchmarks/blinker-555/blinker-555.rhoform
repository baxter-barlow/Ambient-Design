#pragma rhoform-syntax 0.1

module LedIndicator:
    port ctl input
    port gnd power_in
    d1 = new rhoform.lib.semiconductor.Led(color = "red", forward_voltage = 2V +/- 10%):
        part abstract:
            color = "red"
            package = "radial_5mm"
    r_lim = new rhoform.lib.passive.Resistor(resistance = 560ohm +/- 1%):
        part abstract:
            package = "axial_0207"
            power_rating = 250mW
            resistance = 560ohm +/- 1%
    net N_IND_LED(voltage_domain = "vbat_9v"):
        d1.a
        r_lim.b
    ctl ~ r_lim.a
    d1.k ~ gnd

module Blinker555:
    c_byp = new rhoform.lib.passive.Capacitor(capacitance = 100nF +/- 10%):
        part abstract:
            capacitance = 100nF +/- 10%
            dielectric = "X7R"
            package = "0805"
            voltage_rating = 50V
    c_ctl = new rhoform.lib.passive.Capacitor(capacitance = 10nF +/- 10%):
        part abstract:
            capacitance = 10nF +/- 10%
            dielectric = "X7R"
            package = "0805"
            voltage_rating = 50V
    c_t = new rhoform.lib.passive.Capacitor(capacitance = 1uF +/- 5%):
        part abstract:
            capacitance = 1uF +/- 5%
            dielectric = "PET_film"
            package = "radial_5mm"
            voltage_rating = 63V
    indicator = new LedIndicator(color = "red", current = 9.5mA (8mA to 10.5mA))
    j_bat = new rhoform.lib.connector.BatteryConnector9V:
        part "conn.battery_9v/keystone-232@1"
    mh1 = new rhoform.lib.mech.MountingHole(diameter = 3.2mm):
        hardware mounting_hole
        exclude_from_bom
        board_only
    r_a = new rhoform.lib.passive.Resistor(resistance = 100kohm +/- 1%):
        part abstract:
            package = "axial_0207"
            power_rating = 250mW
            resistance = 100kohm +/- 1%
    r_b = new rhoform.lib.passive.Resistor(resistance = 680kohm +/- 1%):
        part abstract:
            package = "axial_0207"
            power_rating = 250mW
            resistance = 680kohm +/- 1%
    timer = new rhoform.lib.timer.Ne555:
        part "timer.555/ti-NE555P@2":
            function = "timer_555"
            supply_max = 16V
    tp_out = new rhoform.lib.mech.TestPoint:
        hardware test_point
        exclude_from_bom
    net GND(ground_domain = "gnd"):
        c_byp.b
        c_ctl.b
        c_t.b
        indicator.gnd
        j_bat.neg
        timer.gnd
    net N_CTL(voltage_domain = "vbat_9v"):
        c_ctl.a
        timer.ctl
    net N_DIS(voltage_domain = "vbat_9v"):
        r_a.b
        r_b.a
        timer.dis
    net N_TH(voltage_domain = "vbat_9v"):
        c_t.a
        r_b.b
        timer.thr
        timer.trig
    net OUT(voltage_domain = "vbat_9v"):
        indicator.ctl
        timer.out
        tp_out.p
    net VCC(voltage_domain = "vbat_9v"):
        c_byp.a
        j_bat.pos
        r_a.a
        timer.rst
        timer.vcc
    assert assert_duty dynamic duty_cycle(OUT) within 0.533 to 0.558
    assert assert_freq dynamic frequency(OUT) within 0.923Hz to 1.052Hz
