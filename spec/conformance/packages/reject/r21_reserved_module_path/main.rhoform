# An author's file whose module path falls under the reserved prefix
# rhoform.lib. would take the bundled library's names, so it is
# refused at the import and never read.
#pragma rhoform-syntax 0.2

import Resistor from "./rhoform/lib/passive"

module Panel:
    port gnd passive
    port vin power_in
    r1 = new Resistor
    vin ~ r1.a
    r1.b ~ gnd
