#pragma rhoform-syntax 0.1
module   Spacing :
  port  p   passive
  r=new lib.R(b=2,a  =  "x")
  w = new lib.R(
          c = true,
      d = false
  )
  x~in.a  ~   b
  net N ( voltage_domain = "5V" , ground_domain = "G" ):
          p
  assert f static frequency (OUT) within 1kHz to 2kHz
  isolated   r.b
  u = new L:
          pin   a   passive   1   2
          no    board_only
