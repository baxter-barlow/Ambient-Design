#pragma rhoform-syntax 0.2

module Ladder(n: int = 8, first: int = 1):
    port top passive
    taps = new rhoform.lib.passive.Resistor[8](resistance = 1kohm)
    for i in range(7):
        port t passive
        taps[i].b ~ taps[i + 1].a
        isolated taps[i].a
    for i in range(first, n):
        for j in range(2):
            if j == 1:
                taps[i].b ~ top

    # the start
    for i in range(1, n):  # the header's trailing comment
        taps[i - 1].b ~ taps[i].a

    isolated top
