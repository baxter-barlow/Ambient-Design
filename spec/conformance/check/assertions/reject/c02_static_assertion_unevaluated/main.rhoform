#pragma rhoform-syntax 0.1

# A declared static-tier assertion that no evaluator measures gates
# (V1): while the static tier is unimplemented, the driver reports every
# one as RHO3553 in the assertions pass's place, beside the coverage note
# the stub's own row raises.
module Board:
    port vin power_in
    net VIN:
        vin
    assert vin_ok static operating_point(VIN) within 4.5V to 5.5V
