#pragma rhoform-syntax 0.2

# `isolated` on an input: the single-pin net is declared, so it is no
# L9b error, but the input it leaves open floats (RHO3107, a warning).
component Chip:
    pin gnd power_in
    pin test input
    pin vdd power_in

module Board:
    c_bulk = new rhoform.lib.passive.Capacitor
    j = new rhoform.lib.connector.BatteryConnector9V
    u = new Chip
    net GND(ground_domain = "gnd"):
        c_bulk.b
        j.neg
        u.gnd
    net VCC:
        c_bulk.a
        j.pos
        u.vdd
    isolated u.test
