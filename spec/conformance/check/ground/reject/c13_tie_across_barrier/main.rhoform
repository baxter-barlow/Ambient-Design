#pragma rhoform-syntax 0.3

# GA-14b: a net-tie across the barrier does not fix a crossing; it defeats
# the declared isolation, RHO4008. The tie is no edge of the tie graph and
# unifies nothing, so there is no ground loop and no second report.
component IsoDcDc:
    pin fb input
    pin gnd_in power_in
    pin gnd_out power_out
    pin vin power_in
    pin vout power_out
    ground gnd_in gnd_out
    side pri: fb gnd_in vin
    side sec: gnd_out vout

component Load:
    pin gnd power_in
    pin vdd power_in
    ground gnd

component Opto:
    pin a passive
    pin c passive
    pin e passive
    pin k passive
    side detector: c e
    side emitter: a k

component NetTie:
    pin a passive
    pin b passive
    tie a b

module Board:
    port vin power_in
    bond = new NetTie
    dcdc = new IsoDcDc
    load = new Load
    opto = new Opto
    r_led = new rhoform.lib.passive.Resistor
    r_pu = new rhoform.lib.passive.Resistor
    net FB:
        dcdc.fb
        opto.c
        r_pu.b
    net GND_PRI(ground_domain = "pri"):
        bond.a
        dcdc.gnd_in
        opto.e
    net GND_SEC(ground_domain = "sec"):
        bond.b
        dcdc.gnd_out
        load.gnd
        opto.k
    net LED:
        opto.a
        r_led.b
    net VIN:
        dcdc.vin
        r_pu.a
        vin
    net VOUT:
        dcdc.vout
        load.vdd
        r_led.a
