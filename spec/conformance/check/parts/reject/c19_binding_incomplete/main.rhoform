#pragma rhoform-syntax 0.2

# The record implements another definition, so nothing joins its
# pins to this one's ports: names are never matched to guess.
component Widget:
    pin gnd_vcc power_in 3
    pin in input 1
    pin out output 2

module Board:
    port vin power_in
    port x input
    port y output
    w = new Widget:
        part "acme/widget"
    vin ~ w.gnd_vcc
    x ~ w.in
    w.out ~ y
