#pragma rhoform-syntax 0.2

# The record is rated for 62.5 mW in ratings.recommended,
# and the instance requires at least 100 mW.
module Board:
    port bottom passive
    port top passive
    r1 = new rhoform.lib.passive.Resistor:
        part abstract:
            power_rating = 100mW
            resistance = 10kohm +/- 1%
    top ~ r1.a
    r1.b ~ bottom
