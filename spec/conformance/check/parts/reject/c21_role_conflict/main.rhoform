#pragma rhoform-syntax 0.2

# The record's IN pin is an output and its OUT pin an input:
# neither can carry the role the definition declares, and a wrong
# role is never overridden.
component Widget:
    pin gnd_vcc power_in 3
    pin in input 1
    pin out output 2

module Board:
    port vin power_in
    port x input
    port y output
    w = new Widget:
        part "acme/widget"
    vin ~ w.gnd_vcc
    x ~ w.in
    w.out ~ y
