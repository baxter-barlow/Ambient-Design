#pragma rhoform-syntax 0.2

# The lockfile's parts section has no keyed pick of this key.
component Widget:
    pin gnd_vcc power_in 3
    pin in input 1
    pin out output 2

module Board:
    port vin power_in
    port x input
    port y output
    w = new Widget:
        part "acme/other"
    vin ~ w.gnd_vcc
    x ~ w.in
    w.out ~ y
