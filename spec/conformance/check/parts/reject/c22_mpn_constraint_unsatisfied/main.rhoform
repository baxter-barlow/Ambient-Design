#pragma rhoform-syntax 0.2

# The instance requires an mpn the picked record does not
# have.
module Board:
    port bottom passive
    port top passive
    r1 = new rhoform.lib.passive.Resistor:
        part abstract:
            mpn = "R-22K"
            resistance = 10kohm +/- 1%
    top ~ r1.a
    r1.b ~ bottom
