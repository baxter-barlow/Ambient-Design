#pragma rhoform-syntax 0.2
module Ladder(n: int = 8, first: int = 1):
    port top passive
    taps = new rhoform.lib.passive.Resistor[8](resistance = 1kohm)
    for i in range(7):
        taps[i].b ~ taps[i + 1].a
    for i in range(1, 8):
        isolated taps[i].b
    for i in range(n):
        if i == 0:
            taps[i].a ~ top
    for i in range(first, 8):
        for j in range(2):
            if j == 1:
                taps[i].b ~ top
    for i in range(first, n):
        taps[i - 1].b ~ taps[i].a
