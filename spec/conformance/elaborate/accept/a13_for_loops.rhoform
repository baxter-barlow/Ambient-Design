# `for`: a loop unrolls over compile-time integers, its variable indexes
# array members (with an offset), a bound may be a parameter or an
# enclosing loop variable, and a net block in a loop is one labelled net.
#pragma rhoform-syntax 0.2

component Cap:
    pin a passive 1
    pin b passive 2

component Resistor:
    pin a passive 1
    pin b passive 2

module Ladder(n: int = 4):
    port bottom passive
    port top passive
    taps = new Resistor[n]
    top ~ taps[0].a

    for i in range(1, n):
        taps[i - 1].b ~ taps[i].a
    for i in range(n):
        if i >= 3:
            taps[i].b ~ bottom

module Top:
    port gnd passive
    port vin power_in
    caps = new Cap[3]
    ladder = new Ladder
    vin ~ ladder.top
    ladder.bottom ~ gnd
    caps[2].a ~ vin

    for i in range(3):
        net GND:
            caps[i].b
            gnd
    for i in range(2):
        for j in range(i, 2):
            if j > i:
                caps[i].a ~ caps[j].a
