# Interim: imports parse, but resolving them belongs to the package layer,
# so each `import` statement is refused once and nothing else is reported
# (a check run without the import would blame every name it binds).
#pragma rhoform-syntax 0.2

import Led from "parts/led.rhoform"

module Panel:
    port vin power_in
    d1 = new Led
    vin ~ d1.a
