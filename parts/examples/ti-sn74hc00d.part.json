    },
    "/pins": {
      "source_id": "ti-sn74hc00-scls181h",
      "locator": "Table 5-1 Pin Functions (D, DB, N, NS, PW, J, or W package column)",
      "confidence": "datasheet-stated",
      "method": "manual",
      "note": "Pin numbering is the 14-pin column, not the 20-pin FK (LCCC) column in the same table. Note the non-monotonic physical layout: 3Y is pin 8 while 3A and 3B are pins 9 and 10, which is why unit membership must be declared explicitly rather than inferred from pin order."
    },
    "/pins/2/capability": {
      "source_id": "ti-sn74hc00-scls181h",
      "locator": "Section 6.5 Electrical Characteristics - Commercial (74xx), VOH and VOL rows at VCC = 4.5 V",
      "confidence": "datasheet-derived",
      "method": "manual",
      "note": "The datasheet states no drive-capability figure directly. It guarantees VOH >= 3.98 V at IOH = -4 mA and VOL <= 0.26 V at IOL = 4 mA (VCC = 4.5 V, 25 C). The 4 mA test condition is therefore the rated drive at which output levels are guaranteed, and is recorded as capability with those conditions attached. The +/-25 mA continuous output current from Absolute Maximum Ratings is a stress limit, not drive capability, and is kept in abs_max.",
      "target": "1Y"
    },
    "/ratings/abs_max": {
      "source_id": "ti-sn74hc00-scls181h",
      "locator": "Section 6.1 Absolute Maximum Ratings; Section 6.2 ESD Ratings",
      "confidence": "datasheet-stated",
      "method": "manual"
    },
    "/ratings/recommended": {
