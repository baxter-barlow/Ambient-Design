    "/units": {
      "source_id": "ti-sn74hc00-scls181h",
      "locator": "Table 5-1 Pin Functions (channel assignments); Section 8.1 Overview ('four independent 2-input NAND gates')",
      "confidence": "datasheet-stated",
      "method": "manual",
      "note": "All four gates share one swappability class because the datasheet describes them as independent and identical, with a single set of electrical characteristics covering all channels. A downstream unit-assignment step may therefore permute gates freely."
    }
